# ==============================================================================
# OpsAgent - Operational AI Assistant Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=opsagent-super-secret-development-key-change-in-production

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Mock ERP Service
MOCK_ERP_HOST=0.0.0.0
MOCK_ERP_PORT=8001
ERP_BASE_URL=http://localhost:8001/api/v1
ERP_API_KEY=mock-erp-secret-key-2026

# Database (PostgreSQL + pgvector)
POSTGRES_USER=opsagent
POSTGRES_PASSWORD=opsagent_password
POSTGRES_DB=opsagent_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://opsagent:opsagent_password@localhost:5432/opsagent_db
# Read-only DB connection string for sql_query tool (security guardrail)
DATABASE_RO_URL=postgresql+psycopg2://opsagent_ro:opsagent_ro_password@localhost:5432/opsagent_db

# LLM Providers Configuration
# Supported: "groq", "openai", "anthropic"
DEFAULT_LLM_PROVIDER=groq

# Router Model (Small & Fast: intent classification & tool routing)
ROUTER_MODEL=llama-3.1-8b-instant
# Synthesis Model (Reasoning & response generation)
SYNTHESIS_MODEL=llama-3.3-70b-versatile

# API Keys (Set the ones you use)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# RAG & Vector Store
# Supported: "chroma", "pgvector"
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_PROVIDER=sentence-transformers # or "openai"
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2 # multilingual model

# Microsoft 365 (Graph API / Mock fallback)
M365_USE_MOCK=true
M365_TENANT_ID=your-azure-tenant-id
M365_CLIENT_ID=your-azure-client-id
M365_CLIENT_SECRET=your-azure-client-secret

# Guardrails & RBAC
GUARDRAILS_ENABLED=true
MASK_PII_ENABLED=true
PROMPT_INJECTION_THRESHOLD=0.75
DEFAULT_USER_ROLE=staff # "staff" or "manager"
